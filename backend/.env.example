# Backend environment template for Aetheron
# Copy this file to backend/.env and replace placeholder values.

# Server
PORT=4000

# Base Mainnet RPC used by launchpad and NFT APIs
BASE_RPC_URL=https://mainnet.base.org
DEPLOYER_PRIVATE_KEY=0xyour64hexprivatekey
TEAM_WALLET=0xYourTeamWalletHere

# Optional launchpad metadata
DEFAULT_TOKEN_DECIMALS=18
DEFAULT_ALLOCATION_PERCENT=1

# Optional NFT contracts on Base Mainnet
NFT_CONTRACT_ADDRESS=0xYourBaseNftContractAddress
NFT_MARKETPLACE_ADDRESS=0xYourBaseMarketplaceAddress
# These must point to persistent storage and the public URL that serves it.
NFT_METADATA_DIR=/persistent/path/to/nft-metadata
NFT_METADATA_PUBLIC_BASE_URL=https://your-metadata-host.example/nft/metadata

# Frontend origins allowed to call the API
ALLOWED_ORIGINS=https://aetrs.com,https://www.aetrs.com,https://mastatrill.github.io

# Push notifications
WALLET_ADDRESSES=0xYourWallet1,0xYourWallet2
ONESIGNAL_APP_ID=your-onesignal-app-id
ONESIGNAL_API_KEY=your-onesignal-rest-api-key
USER_MAP={"0xyourwallet1":"onesignal-player-id-1","0xyourwallet2":"onesignal-player-id-2"}

# Optional commerce / email integrations
COINBASE_COMMERCE_API_KEY=your-coinbase-commerce-api-key
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
EMAIL_FROM=notifications@aetrs.com
