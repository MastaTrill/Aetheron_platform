{
  "type": "module",
  "name": "aetheron-smart-contracts",
  "version": "1.0.0",
  "description": "Smart contracts for Aetheron Platform",
  "main": "index.js",
  "scripts": {
    "compile": "hardhat compile",
    "test": "npm run compile && node --test --test-concurrency=1 test/*.test.js",
    "test:aeth-v2": "npm run compile && node --test --test-concurrency=1 test/AetheronV2.test.js test/AetheronV2DeploymentSafety.test.js test/AetheronV2MigrationInvariants.test.js test/AetheronV2MigrationLedger.test.js test/AetheronV2StandardErc20.test.js",
    "test:production-simulation": "node --test test/ProductionPresaleSimulation.test.js",
    "test:base-fork": "node --test test/BaseForkReadOnly.fork.js",
    "verify:base:readonly": "node scripts/verify-base-presale-state.mjs",
    "verify:basescan": "node scripts/verify-basescan-v2.mjs",
    "record:verified-frontend": "node scripts/record-verified-presale-frontend.mjs",
    "inspect:invalid-presale": "node scripts/inspect-invalid-presale-recovery.mjs",
    "deploy:presale": "node scripts/deploy-base-presale-bounded.mjs",
    "deploy:presale:base:safe": "node scripts/deploy-base-presale-bounded.mjs",
    "deploy:base-presale:dry-run": "DRY_RUN=true node scripts/deploy-base-presale-bounded.mjs",
    "rehearsal:base-sepolia:presale": "node scripts/deploy-base-sepolia-presale-rehearsal.mjs",
    "verify:base-sepolia:rehearsal": "node scripts/verify-base-sepolia-rehearsal.mjs",
    "cancel:invalid-base-presale": "node scripts/cancel-invalid-base-presale.mjs",
    "test:coverage": "node -e \"console.log('Coverage tooling was removed during dependency hardening. Re-add solidity-coverage if you need contract coverage reports.')\"",
    "deploy:local": "hardhat run scripts/deploy.mjs --network hardhat",
    "deploy:sepolia": "hardhat run scripts/deploy.mjs --network sepolia",
    "deploy:aeth-v2:base": "hardhat run scripts/deploy-aeth-v2.mjs --network base",
    "deploy:base": "hardhat run scripts/deploy-subscription.mjs --network base",
    "deploy:base-sepolia": "hardhat run scripts/deploy-subscription.mjs --network baseSepolia",
    "verify": "node scripts/verify-contracts.mjs base",
    "verify:sepolia": "node scripts/verify-contracts.mjs sepolia",
    "node": "hardhat node",
    "clean": "hardhat clean",
    "verify:base": "node scripts/verify-contracts.mjs base"
  },
  "keywords": [
    "solidity",
    "ethereum",
    "base",
    "smart-contracts",
    "hardhat",
    "aetheron"
  ],
  "author": "MastaTrill",
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.0.13",
    "@openzeppelin/contracts-upgradeable": "^4.9.6",
    "ethers": "^6.16.0",
    "hardhat": "^3.9.0"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^4.9.6",
    "dotenv": "^16.3.1"
  },
  "overrides": {
    "undici": "^6.24.1",
    "serialize-javascript": "^7.0.5"
  },
  "directories": {
    "test": "test"
  }
}
