# Aetheron Smart Contract Operator Environment
# Copy to .env only on a trusted operator machine. Never commit real private keys.

# Base operator signer. Must hold ETH on Base for gas before any live deployment.
PRIVATE_KEY=0xYOUR_64_HEX_PRIVATE_KEY

# Base RPC / explorer
BASE_RPC_URL=https://mainnet.base.org
BASE_FORK_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASESCAN_API_KEY=your_basescan_api_key

# Current canonical AETH V1 on Base. Do not replace this until V2 cutover is verified.
AETH_TOKEN_ADDRESS=0xecf7E17faE148C01E1b5008A31Dfd2d1B6608E4e

# Legacy deployment wallet placeholders used by older Base-safe scripts.
TEAM_WALLET=0x0000000000000000000000000000000000000000
MARKETING_WALLET=0x0000000000000000000000000000000000000000
STAKING_POOL=0x0000000000000000000000000000000000000000

# AETH V2 constructor destinations. Use reviewed, distinct, nonzero Base addresses.
AETH_V2_TEAM_WALLET=0x0000000000000000000000000000000000000000
AETH_V2_MARKETING_WALLET=0x0000000000000000000000000000000000000000
AETH_V2_STAKING_POOL=0x0000000000000000000000000000000000000000

# Live V2 deployment gates. Leave disabled unless intentionally deploying on Base Mainnet.
CONFIRM_AETH_V2_DEPLOYMENT=
LIVE_ACTION=false
CONFIRM_LIVE_ACTION=

# Existing generic Base deployment gate. Leave disabled by default.
CONFIRM_BASE_DEPLOYMENT=
